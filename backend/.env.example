# Clerk authentication (email + password, email-code verification).
# The publishable key is enough — the JWKS/issuer domain is encoded inside it.
# From the Clerk dashboard → API Keys. Same key the frontend uses.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional explicit override (rarely needed):
# CLERK_ISSUER=https://your-slug.clerk.accounts.dev
# Dev only — skip token verification entirely (smoke_test.sh needs this):
# AUTH_DEV_MODE=1

# Database connection string.
# Unset (or the line below) uses local SQLite:
DATABASE_URL=sqlite:///./WhereTheyAt.db
# Postgres example (Railway/Render managed Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/wheretheyat

# Object storage for uploads (avatars, album photos).
# Leave S3_BUCKET unset to store files on local disk (dev only — ephemeral in prod).
# S3_BUCKET=wheretheyat-uploads
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-west-2
# Optional: S3-compatible endpoint (Cloudflare R2, MinIO). Leave unset for AWS.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# Optional: public/CDN base URL for reading objects (recommended; e.g. an R2
# public bucket URL or CloudFront). Without it, the bucket itself must allow
# public GETs and the AWS virtual-hosted URL is used.
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev
