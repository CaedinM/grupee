# Clerk authentication (email + password, email-code verification).
# The publishable key is enough — the JWKS/issuer domain is encoded inside it.
# From the Clerk dashboard → API Keys. Same key the frontend uses.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional explicit override (rarely needed):
# CLERK_ISSUER=https://your-slug.clerk.accounts.dev
# Dev only — skip token verification entirely (smoke_test.sh needs this):
# AUTH_DEV_MODE=1

# Database connection string. Alembic reads this too, so `alembic upgrade head`
# always targets the same database the app does.
# Local dev default — a local Postgres (engine parity with prod). Replace the
# role with your OS user; Homebrew Postgres uses trust auth with no password:
DATABASE_URL=postgresql://postgres@localhost:5432/wheretheyat_dev
# Zero-setup fallback — comment the line above and use file-based SQLite:
# DATABASE_URL=sqlite:///./WhereTheyAt.db
# On Railway, set this to the reference ${{Postgres.DATABASE_URL}} rather than a
# literal URL; a postgres:// scheme is rewritten to postgresql+psycopg2://.

# Log level for the request logger (default INFO).
# LOG_LEVEL=INFO

# Redis — the live-location store (positions never hit the SQL database).
# Defaults to a local Redis; any local instance works (e.g.
# `docker run -p 6379:6379 redis:7`). On Railway, add a Redis database and set
# this to the reference ${{Redis.REDIS_URL}} so it stays on the private network.
# REDIS_URL=redis://localhost:6379/0
# Seconds before a position with no fresh report expires (member drops to
# location:null instead of freezing on the map). Default 90.
# LOCATION_TTL_SECONDS=90

# Object storage for uploads (avatars, album photos) — Cloudflare R2.
#
# Per-environment split (deliberate):
#   local   → leave S3_BUCKET UNSET. Files fall back to local disk under
#             uploads/, served by the /static mount. No cloud credential on
#             your machine; avatarUri() renders the relative path fine.
#   staging → its own throwaway bucket (wipe freely alongside staging's DB).
#   prod    → its own bucket + its own least-privilege token; real user data,
#             kept isolated from dev churn. Never share prod's bucket with dev.
# Object keys are avatars/<user_id>-<hash>, and user_ids are unique per DB, so
# even a shared bucket never collides — but separate buckets keep prod clean.
#
# Set the block below only in the Railway staging/prod service Variables:
# S3_BUCKET=wheretheyat-avatars-prod
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com   # same in both envs
# S3_PUBLIC_URL=https://pub-xxxx.r2.dev   # per-bucket; enable Public access to get it
# AWS_REGION=auto                          # R2's region is literally "auto"
# AWS_ACCESS_KEY_ID=...                     # R2 *Account* API token (Object Read & Write)
# AWS_SECRET_ACCESS_KEY=...                 # shown once when the token is created
